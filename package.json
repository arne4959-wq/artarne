{
  "name": "circles",
  "private": true,
  "description": "circles — a Brutalist Punk city of artists. Plain HTML/CSS/JS, moving to React in app/ (see docs/react-migration). This file only holds the dev scripts below.",
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "python3 serve.py",
    "build": "node tools/build.mjs",
    "dist": "node tools/dist.mjs",
    "stamp": "node tools/stamp.mjs",
    "pictures": "node tools/get-pictures.mjs",
    "lao-review": "node tools/lao-review.mjs",
    "doctor": "node tools/doctor.mjs",
    "check": "node tools/check-release.mjs",
    "check:live": "node tools/check-release.mjs --strict",
    "test": "node tests-legacy/run.mjs",
    "test:perf": "node tests-legacy/run.mjs perf",
    "test:all": "node tests-legacy/run.mjs all",
    "pull": "node tools/pull-artists.mjs",
    "merge-live": "node tools/merge-live.mjs",
    "db:bundle": "node tools/sql-bundle.mjs",
    "db:seed": "node tools/seed-sql.mjs",
    "test:db": "node supabase/tests/rls.mjs",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:test": "npm --prefix app test"
  }
}
